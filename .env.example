# Target OpenShift kubeconfig path (or default ~/.kube/config)
KUBECONFIG=~/.kube/config

# Base gateway ingress URL for your OpenShift cluster
MAAS_GATEWAY_URL="https://maas.apps.<cluster-domain>"

# Optional: Override MAAS_API if not using standard path
# MAAS_API="https://maas.apps.<cluster-domain>/maas-api/v1"

# Optional defaults
# Must match an active MaaSSubscription name deployed on the cluster:
# e.g., 'gpt-oss-20b-free' for gpt-oss-20b, 'qwen3-06b-free' for qwen3-06b,
# or 'gpt-oss-20b-premium' / 'qwen3-06b-premium' for premium tiers.
MAAS_SUBSCRIPTION=gpt-oss-20b-free
MAAS_MODEL=gpt-oss-20b

# External model provider credentials and remote inference cluster hosts
MAAS_INFERENCE_CLUSTER_A_HOST=maas.apps.maas-inference-a.example.com
MAAS_INFERENCE_CLUSTER_A_TOKEN=your-inference-cluster-token
MAAS_RHDP_HOST=maas-rhdp.apps.maas.redhatworkshops.io
MAAS_RHDM_API_KEY=sk-your-rhdm-api-key
